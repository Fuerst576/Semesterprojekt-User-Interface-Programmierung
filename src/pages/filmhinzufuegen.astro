---
import BaseLayout from "../layouts/BaseLayout.astro";
const pageTitle = "Film Hinzufügen";

const responsegenres = await fetch("https://mt241022-10927.node.ustp.cloud/genres");
const genres = await responsegenres.json();

const response = await fetch("https://mt241022-10927.node.ustp.cloud/users");
const users = await response.json();
---

<BaseLayout>
<form id="hinzufügen">
    <label for="titel">Titel:</label>
    <input type="text" id="titel" required />
    <br />

    <label for="genre">Genre:</label>
    <select id="genre">
        <option value="">Genre auswählen</option>
        {genres.map((genre) => (
                <option value={genre.id}>{genre.name}</option>
        ))}
    </select>
    <br />

    <label for="description">Description:</label>
    <input type="text" id="description" required />
    <br />

    <button type="submit">Film Hinzufügen</button>
</form>
</BaseLayout>



<script type="module">
    const username = localStorage.getItem("username");

    if (!username) {
        window.location.href = "/login";
    }

    try {
        const res = await fetch(
            `https://mt241022-10927.node.ustp.cloud/users/${username}`,
            {
                method: "GET",
            }
        );

        if (!res.ok) {
            window.location.href = "/login";
        } else {
            console.log("Benutzer gefunden:", username);
        }
    } catch (err) {
        console.error("Backend nicht erreichbar");
        window.location.href = "/login";
    }

</script>

<script>
    const form = document.getElementById("hinzufügen");


    form.addEventListener("submit", async (e) => {
        e.preventDefault();

        const title = document.getElementById("titel").value;
        const genreId = document.getElementById("genre").value;
        const description = document.getElementById("description").value;
        const token = localStorage.getItem("token");


        if (!genreId) {
            alert("Bitte ein Genre auswählen");
            return;
        }

        const username = localStorage.getItem("username");

        const resUser = await fetch(
            `https://mt241022-10927.node.ustp.cloud/users/${username}`
        );



        const user = await resUser.json();

        const resFilm = await fetch(
            "https://mt241022-10927.node.ustp.cloud/films",
            {
                method: "POST",
                headers: {
                    "Content-Type": "application/json",
                    "Authorization": `Bearer ${token}`, 
                },
                body: JSON.stringify({
                    title: title,
                    genre_id: Number(genreId),
                    user_id: user.id,
                    description: description,
                }),
            }
        );

        if (!resFilm.ok) {
            alert("Film konnte nicht gespeichert werden");
            return;
        }

        window.location.href = "/";

        console.log({
            title,
            genre_id: Number(genreId),
            user_id: user.id,
            description,
        });

    });
</script>


